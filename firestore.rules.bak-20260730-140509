rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /* Auth helpers */

    function claimRole() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : "";
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profileData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileRole() {
      return hasProfile() && profileData().role is string
        ? profileData().role
        : "";
    }

    function isActiveProfile() {
      return isSignedIn()
        && (!hasProfile()
          || (
            profileData().active != false
            && profileData().disabled != true
            && profileData().deleted != true
          ));
    }

    function role() {
      return isSignedIn()
        ? (claimRole() != "" ? claimRole() : (isActiveProfile() ? profileRole() : ""))
        : "";
    }

    function hasRole(expected) {
      return role() == expected;
    }

    function isAdmin() {
      return role() == "admin" || role() == "tank";
    }

    function isStaff() {
      return hasRole("staff");
    }

    function isTank() {
      return hasRole("tank");
    }

    function isStaffOrAdmin() {
      return isAdmin() || isStaff() || isTank();
    }

    /* Field validators */

    function optionalString(data, field, maxSize) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxSize);
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function validCpapSupplyPull(data) {
      return data.keys().hasOnly([
          "id",
          "patientKey",
          "patientName",
          "supplyId",
          "supplyLabel",
          "dueDate",
          "status",
          "pulledAt",
          "pickedUpAt",
          "createdAt",
          "updatedAt",
        ])
        && data.keys().hasAll(["patientKey", "supplyId", "dueDate", "status"])
        && data.patientKey is string
        && data.patientKey.size() > 0
        && data.patientKey.size() <= 160
        && data.supplyId is string
        && data.supplyId.size() > 0
        && data.supplyId.size() <= 80
        && data.dueDate is string
        && data.dueDate.size() <= 40
        && data.status in ["pulled", "picked_up", "cancelled"]
        && optionalString(data, "id", 160)
        && optionalString(data, "patientName", 160)
        && optionalString(data, "supplyLabel", 160)
        && optionalString(data, "pulledAt", 80)
        && optionalString(data, "pickedUpAt", 80)
        && optionalTimestamp(data, "createdAt")
        && optionalTimestamp(data, "updatedAt");
    }

    function validCpapSupplyCallNote(data) {
      return data.keys().hasOnly([
          "patientKey",
          "patientName",
          "phone",
          "notes",
          "suppliesSummary",
          "updatedAt",
        ])
        && data.keys().hasAll(["patientKey", "notes"])
        && data.patientKey is string
        && data.patientKey.size() > 0
        && data.patientKey.size() <= 160
        && data.notes is string
        && data.notes.size() <= 4000
        && optionalString(data, "patientName", 160)
        && optionalString(data, "phone", 80)
        && optionalString(data, "suppliesSummary", 1000)
        && optionalTimestamp(data, "updatedAt");
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function createdBySelf() {
      return isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
    }

    function safeSelfUserUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "active",
        "deleted",
        "disabled",
        "role",
        "uid",
      ]);
    }

    /* Collection rules */

    match /settings/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /analytics/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if isStaffOrAdmin();
        allow write: if isAdmin();
      }
    }

    match /patientIndex/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /apiRegistry/{docId} {
      allow read: if isStaffOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /vendorResearchSites/{docId} {
      allow read: if isStaffOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /dashboardPreview/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /products/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /hcpcsCodes/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /referenceImports/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /inventory/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /stockMovements/{docId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /cpapSetupAppointments/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /cpapSupplyPulls/{docId} {
      allow read: if isStaffOrAdmin();
      allow create, update: if isStaffOrAdmin() && validCpapSupplyPull(request.resource.data);
      allow delete: if isAdmin();
    }

    match /cpapSupplyCallNotes/{docId} {
      allow read: if isStaffOrAdmin();
      allow create, update: if isStaffOrAdmin() && validCpapSupplyCallNote(request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /rentals/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /rolodexContacts/{docId} {
      allow read: if isStaffOrAdmin();
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    match /qrCards/{docId} {
      allow read: if isStaffOrAdmin();
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    match /qrScanEvents/{docId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSelf(userId) && safeSelfUserUpdate());
      allow delete: if isAdmin();
    }

    match /employeeEvaluations/{docId} {
      allow read, write: if isTank();
    }

    match /employeeEvaluationComments/{docId} {
      allow read, create, update, delete: if isTank();
    }

    match /employeeEvaluationSnapshots/{docId} {
      allow read, create, update, delete: if isTank();
    }

    match /retailCustomerContacts/{docId} {
      allow read: if isStaffOrAdmin();
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    match /complianceIssues/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /tasks/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /hospiceOversight/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /equipmentRecalls/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /recallMatches/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /cmnQueue/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /parAlerts/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /patients/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();

      match /documents/{documentId} {
        allow read: if isStaffOrAdmin();
        allow create, update: if isStaffOrAdmin();
        allow delete: if isAdmin();
      }

      match /equipment/{equipmentId} {
        allow read: if isStaffOrAdmin();
        allow create, update: if isStaffOrAdmin();
        allow delete: if isAdmin();
      }

      match /timeline/{timelineId} {
        allow read: if isStaffOrAdmin();
        allow create: if isStaffOrAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /patients_index/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /hospicePatients/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /insuranceRecords/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /insurance/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /insurancePatients/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /insuranceQueue/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /patientAuthorizations/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /patientDeliveryTickets/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /deliveryFulfillmentScans/{docId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /deliverySignatures/{docId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /deliveryDamagePhotos/{docId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /deliveryTechLocations/{docId} {
      allow read: if isAdmin();
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /chartExportLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /wipRecords/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /patientPhysicians/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /patientReferrals/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /shopItems/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /shopInventoryLots/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /shopInventorySerials/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /shopGlAccountGroups/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /shopGlDetails/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /shopCostOfGoodsSold/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /shopRawReports/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /importJobs/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();

      match /rows/{rowId} {
        allow read: if isStaffOrAdmin();
        allow write: if isStaffOrAdmin();
      }
    }

    match /importQueue/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /importedReports/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();

      match /rows/{rowId} {
        allow read: if isStaffOrAdmin();
        allow write: if isStaffOrAdmin();
      }
    }

    match /aiConversations/{conversationId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() && createdBySelf();
      allow update: if isStaffOrAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isStaffOrAdmin();
        allow create: if isStaffOrAdmin() && createdBySelf();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /notifications/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /inventoryTransactions/{docId} {
      allow read: if isStaffOrAdmin();
      allow create: if false; // Only Cloud Functions may create entries
      allow update: if false; // Transaction records are immutable
      allow delete: if false; // Transaction records are immutable
    }

    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if false; // Only Cloud Functions may create entries
      allow update: if false; // Audit records are immutable
      allow delete: if false; // Audit records are immutable
    }

    match /phiAlerts/{docId} {
      allow read: if isStaffOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /improvementProposals/{docId} {
      allow read: if isStaffOrAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Collection group queries — required for indexes defined in firestore.indexes.json
    match /{path=**}/rows/{rowId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
