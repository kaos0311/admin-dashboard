{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],

    "allowJs": false,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "module": "esnext",
    "moduleResolution": "bundler",

    "resolveJsonModule": true,
    "isolatedModules": true,

    "jsx": "react-jsx",

    "incremental": true,

    "paths": {
      "@/*": ["./*"]
    },

    "types": ["node"],

    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "coverage",
    "functions/lib",
    "firebase-debug.log",
    "firestore-debug.log",
    "scripts"
  ]
}