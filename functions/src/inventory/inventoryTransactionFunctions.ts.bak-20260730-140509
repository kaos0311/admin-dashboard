import { getApps, initializeApp } from "firebase-admin/app";
import { getFirestore } from "firebase-admin/firestore";
import { HttpsError, onCall } from "firebase-functions/v2/https";

import {
  resolveInventoryItem,
  mutateInventory,
  writeInventoryTransaction,
  type InventoryTransactionInput,
  type InventoryTransactionResult,
} from "./inventoryTransactionService.js";

if (!getApps().length) {
  initializeApp();
}

const db = getFirestore();

/**
 * Helper to execute a generic inventory transaction.
 */
async function executeTransaction(
  request: {
    auth?: { uid?: string; token?: Record<string, unknown> };
    data?: Record<string, unknown>;
  },
  transactionType: "receive" | "issue" | "cycle_count" | "transfer"
): Promise<Record<string, unknown>> {
  if (!request.auth) {
    throw new HttpsError("unauthenticated", "You must be signed in.");
  }

  const uid = request.auth.uid!;
  const email = String(request.auth.token?.email ?? request.auth.uid!);

  // Validate authentication via token role or user doc
  const role = request.auth.token?.role;
  const isStaffOrAdmin = role === "admin" || role === "staff" || role === "tank";
  if (!isStaffOrAdmin) {
    // Double-check via user doc
    const userSnap = await db.collection("users").doc(uid).get();
    const userData = userSnap.exists ? userSnap.data() : null;
    const docRole = userData?.role;
    const isDisabled =
      userData?.active === false ||
      userData?.disabled === true ||
      userData?.deleted === true;

    if (isDisabled || !(docRole === "admin" || docRole === "staff" || docRole === "tank")) {
      throw new HttpsError("permission-denied", "Insufficient permissions.");
    }
  }

  const rawBarcode = request.data?.barcode;
  if (typeof rawBarcode !== "string" || !rawBarcode.trim()) {
    throw new HttpsError("invalid-argument", "Barcode is required.");
  }

  const normalizedBarcode = rawBarcode.trim();
  if (normalizedBarcode.length > 128) {
    throw new HttpsError("invalid-argument", "Barcode exceeds maximum length.");
  }

  const rawScan = typeof request.data?.rawScan === "string" ? request.data.rawScan : null;
  const source =
    request.data?.source === "tera_hid_scanner" || request.data?.source === "manual_entry"
      ? (request.data.source as "tera_hid_scanner" | "manual_entry")
      : "manual_entry";

  // Resolve the inventory item server-side
  const resolved = await resolveInventoryItem(db, normalizedBarcode);

  if (!resolved) {
    const input: InventoryTransactionInput = {
      transactionType,
      barcode: normalizedBarcode,
      normalizedBarcode,
      inventoryItemId: null,
      quantityChange: null,
      performedByUid: uid,
      performedByEmail: email,
      source,
      rawScan,
    };

    const result: InventoryTransactionResult = {
      success: false,
      transactionId: "",
      inventoryItemId: null,
      productName: null,
      quantityBefore: null,
      quantityChange: null,
      quantityAfter: null,
      status: "not_found",
      failureReason: "No inventory item matches this barcode.",
    };

    result.transactionId = await writeInventoryTransaction(db, input, result);

    return {
      success: false,
      transactionId: result.transactionId,
      status: "not_found",
      message: "No inventory item matches this barcode.",
    };
  }

  // Validate quantity
  let quantityChange: number;

  switch (transactionType) {
    case "issue": {
      const qty = request.data?.quantity;
      quantityChange = typeof qty === "number" && Number.isFinite(qty) && qty > 0 ? -Math.floor(qty) : -1;
      break;
    }
    case "cycle_count": {
      const qty = request.data?.quantity;
      if (typeof qty !== "number" || !Number.isFinite(qty) || qty < 0) {
        throw new HttpsError("invalid-argument", "Cycle count requires a non-negative quantity.");
      }
      // For cycle count, we set delta to (new count - current count)
      const currentQty = Number((resolved.data.quantityOnHand as number) ?? 0);
      quantityChange = qty - currentQty;
      break;
    }
    case "transfer": {
      const qty = request.data?.quantity;
      quantityChange = typeof qty === "number" && Number.isFinite(qty) && qty > 0 ? -Math.floor(qty) : -1;
      break;
    }
    default:
      throw new HttpsError("invalid-argument", "Invalid transaction type.");
  }

  // Check for duplicates of same barcode for mutation transactions
  // (only relevant for issue — cycle_count/transfer are explicit)
  // Note: receive is no longer handled by this generic path — the dedicated
  // receiveInventoryByBarcode callable uses operationId-based idempotency.
  if (transactionType === "issue") {
    const fiveSecondsAgo = new Date(Date.now() - 5000);
    const recentSnap = await db
      .collection("inventoryTransactions")
      .where("normalizedBarcode", "==", normalizedBarcode)
      .where("transactionType", "==", transactionType)
      .where("timestamp", ">=", fiveSecondsAgo)
      .where("performedByUid", "==", uid)
      .limit(1)
      .get();

    if (!recentSnap.empty) {
      throw new HttpsError(
        "already-exists",
        `Duplicate ${transactionType} detected for this barcode within 5 seconds.`
      );
    }
  }

  // Perform mutation
  const allowNegative = transactionType === "cycle_count"; // cycle count can correct to zero
  const mutation = await mutateInventory(db, resolved.id, quantityChange, allowNegative);

  const input: InventoryTransactionInput = {
    transactionType,
    barcode: normalizedBarcode,
    normalizedBarcode,
    inventoryItemId: resolved.id,
    quantityChange,
    fromLocationId:
      transactionType === "transfer"
        ? String(resolved.data.locationName ?? "")
        : null,
    toLocationId:
      transactionType === "transfer"
        ? (request.data?.toLocation as string) ?? null
        : null,
    performedByUid: uid,
    performedByEmail: email,
    source,
    rawScan,
  };

  const result: InventoryTransactionResult = {
    success: true,
    transactionId: "",
    inventoryItemId: resolved.id,
    productName: mutation.productName,
    quantityBefore: mutation.quantityBefore,
    quantityChange,
    quantityAfter: mutation.quantityAfter,
    status: "success",
    failureReason: null,
  };

  result.transactionId = await writeInventoryTransaction(db, input, result);

  return {
    success: true,
    transactionId: result.transactionId,
    inventoryItemId: resolved.id,
    productName: mutation.productName,
    quantityBefore: mutation.quantityBefore,
    quantityChange,
    quantityAfter: mutation.quantityAfter,
    status: "success",
  };
}

/**
 * Issue/remove inventory by barcode.
 */
export const issueInventoryByBarcode = onCall(
  {
    region: "us-central1",
    timeoutSeconds: 30,
    memory: "256MiB",
    maxInstances: 10,
  },
  async (request) => {
    return executeTransaction(request, "issue");
  }
);

/**
 * Cycle count inventory by barcode.
 */
export const cycleCountInventoryByBarcode = onCall(
  {
    region: "us-central1",
    timeoutSeconds: 30,
    memory: "256MiB",
    maxInstances: 10,
  },
  async (request) => {
    return executeTransaction(request, "cycle_count");
  }
);

/**
 * Transfer inventory by barcode to a new location.
 */
export const transferInventoryByBarcode = onCall(
  {
    region: "us-central1",
    timeoutSeconds: 30,
    memory: "256MiB",
    maxInstances: 10,
  },
  async (request) => {
    const toLocation = request.data?.toLocation;
    if (!toLocation || typeof toLocation !== "string" || !toLocation.trim()) {
      throw new HttpsError("invalid-argument", "Destination location is required for transfer.");
    }
    return executeTransaction(request, "transfer");
  }
);
