rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /*
    |--------------------------------------------------------------------------
    | AUTH HELPERS
    |--------------------------------------------------------------------------
    */

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function currentUserPath() {
      return userDocPath(request.auth.uid);
    }

    function currentUserExists() {
      return signedIn() &&
        firestore.exists(currentUserPath());
    }

    function currentUserData() {
      return firestore.get(currentUserPath()).data;
    }

    function tokenRole() {
      return signedIn() &&
        request.auth.token.role is string
        ? request.auth.token.role
        : "";
    }

    function docRole() {
      return currentUserExists() &&
        currentUserData().role is string
        ? currentUserData().role
        : "";
    }

    function hasRole(role) {
      return tokenRole() == role ||
        docRole() == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isStaff() {
      return hasRole("staff");
    }

    function isStaffOrAdmin() {
      return isAdmin() || isStaff();
    }

    /*
      IMPORTANT:
      Do NOT require user.active checks inside Storage Rules.
      Handle inactive-user blocking in frontend auth/session logic.

      Firestore lookups during uploads can cause instability,
      stalls, and intermittent failures.
    */
    function canAccessDashboard() {
      return signedIn() &&
        isStaffOrAdmin();
    }

    function canAdminWrite() {
      return signedIn() &&
        isAdmin();
    }

    /*
    |--------------------------------------------------------------------------
    | FILE VALIDATION
    |--------------------------------------------------------------------------
    */

    function hasIncomingFile() {
      return request.resource != null;
    }

    function isPdf() {
      return hasIncomingFile() &&
        request.resource.contentType.matches("application/pdf.*");
    }

    function isCsv() {
      return hasIncomingFile() &&
        (
          request.resource.contentType == "text/csv" ||
          request.resource.contentType == "application/csv" ||
          request.resource.contentType == "application/vnd.ms-excel" ||
          request.resource.contentType.matches(".*csv.*")
        );
    }

    function isJson() {
      return hasIncomingFile() &&
        request.resource.contentType.matches("application/json.*");
    }

    function isText() {
      return hasIncomingFile() &&
        request.resource.contentType.matches("text/.*");
    }

    function isImage() {
      return hasIncomingFile() &&
        request.resource.contentType.matches("image/.*");
    }

    function isReportFile() {
      return isCsv();
    }

    function isReportSizeAllowed() {
      return hasIncomingFile() &&
        request.resource.size > 0 &&
        request.resource.size <= 100 * 1024 * 1024;
    }

    function isPatientDocumentSizeAllowed() {
      return hasIncomingFile() &&
        request.resource.size > 0 &&
        request.resource.size <= 50 * 1024 * 1024;
    }

    function isImageSizeAllowed() {
      return hasIncomingFile() &&
        request.resource.size > 0 &&
        request.resource.size <= 25 * 1024 * 1024;
    }

    /*
    |--------------------------------------------------------------------------
    | REPORT UPLOADS
    |--------------------------------------------------------------------------
    */

    match /reports/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      /*
        Allows:
        - upload
        - overwrite
        - retry
        - reprocess
        - batch import replacement
      */
      allow create, update:
        if canAccessDashboard() &&
        isReportSizeAllowed() &&
        isReportFile();

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | REPORT STAGING
    |--------------------------------------------------------------------------
    */

    match /report-staging/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if canAccessDashboard() &&
        isReportSizeAllowed() &&
        isReportFile();

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | IMPORT PIPELINE
    |--------------------------------------------------------------------------
    */

    match /imports/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if canAccessDashboard() &&
        isReportSizeAllowed() &&
        isReportFile();

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | IMPORT JOB ARTIFACTS
    |--------------------------------------------------------------------------
    */

    match /import-jobs/{jobId}/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if canAccessDashboard() &&
        isReportSizeAllowed();

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | GENERATED REPORTS / EXPORTS
    |--------------------------------------------------------------------------
    */

    match /generated-reports/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if canAccessDashboard();

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | ANALYTICS EXPORTS
    |--------------------------------------------------------------------------
    */

    match /analytics-exports/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if canAccessDashboard();

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | PATIENT DOCUMENTS
    |--------------------------------------------------------------------------
    */

    match /patient-documents/{patientId}/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if canAccessDashboard() &&
        isPatientDocumentSizeAllowed() &&
        (
          isPdf() ||
          isImage()
        );

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | LEGACY CAMELCASE PATH
    |--------------------------------------------------------------------------
    */

    match /patientDocuments/{patientId}/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if canAccessDashboard() &&
        isPatientDocumentSizeAllowed() &&
        (
          isPdf() ||
          isImage()
        );

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | USER AVATARS / PROFILE IMAGES
    |--------------------------------------------------------------------------
    */

    match /user-avatars/{uid}/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if signedIn() &&
        request.auth.uid == uid &&
        isImage() &&
        isImageSizeAllowed();

      allow delete:
        if signedIn() &&
        (
          request.auth.uid == uid ||
          isAdmin()
        );
    }

    /*
    |--------------------------------------------------------------------------
    | AI GENERATED FILES
    |--------------------------------------------------------------------------
    */

    match /ai-generated/{allPaths=**} {

      allow read:
        if canAccessDashboard();

      allow create, update:
        if canAccessDashboard();

      allow delete:
        if canAdminWrite();
    }

    /*
    |--------------------------------------------------------------------------
    | TEMP PROCESSING FILES
    |--------------------------------------------------------------------------
    */

    match /tmp/{allPaths=**} {

      allow read, write:
        if canAccessDashboard();
    }

    /*
    |--------------------------------------------------------------------------
    | FIREBASE EXTENSIONS
    |--------------------------------------------------------------------------
    */

    match /extensions/{allPaths=**} {

      allow read, write:
        if false;
    }

    /*
    |--------------------------------------------------------------------------
    | DENY EVERYTHING ELSE
    |--------------------------------------------------------------------------
    */

    match /{allPaths=**} {

      allow read, write:
        if false;
    }
  }
}
