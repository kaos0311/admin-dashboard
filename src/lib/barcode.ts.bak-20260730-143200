/**
 * Barcode normalization and validation utilities.
 *
 * Key design decisions:
 * - Never convert barcodes to JavaScript Number (preserves leading zeroes)
 * - Supports alphanumeric barcodes (Code 39, Code 128)
 * - Records raw scanned value separately for audit
 * - Configurable maximum length to reject obviously corrupted scans
 */

export interface NormalizedBarcode {
  /** The cleaned, normalized barcode string */
  value: string;
  /** The raw value as received from the scanner */
  rawValue: string;
  /** Whether the value passed all validation checks */
  valid: boolean;
  /** Rejection reason if not valid */
  error?: string;
}

const DEFAULT_MAX_LENGTH = 128;
const SCANNER_SUFFIX_CHARS = new Set(["\r", "\n", "\t", "\x00"]);
const URL_PATTERN = /^[a-z][a-z0-9+.-]*:\/\//i;

/**
 * Normalize a raw barcode string from a scanner.
 *
 * Rules:
 * - Trims whitespace
 * - Removes scanner suffix characters (CR, LF, tab, null)
 * - Preserves leading zeroes
 * - Rejects empty values
 * - Enforces configurable maximum length
 * - Does NOT convert to number
 * - Supports letters for Code 39 and Code 128
 * - Returns the raw value separately for audit trail
 */
export function normalizeBarcode(
  rawValue: string,
  options?: { maxLength?: number }
): string {
  const result = parseBarcode(rawValue, options);
  return result.valid ? result.value : "";
}

/**
 * Full barcode parsing with structured result.
 */
export function parseBarcode(
  rawValue: string,
  options?: { maxLength?: number }
): NormalizedBarcode {
  const maxLength = options?.maxLength ?? DEFAULT_MAX_LENGTH;
  const rawTrimmed = rawValue.trim();

  if (!rawTrimmed) {
    return {
      value: "",
      rawValue: rawValue,
      valid: false,
      error: "Barcode is empty",
    };
  }

  // Remove scanner suffix characters
  let cleaned = "";
  for (const ch of rawTrimmed) {
    if (!SCANNER_SUFFIX_CHARS.has(ch)) {
      cleaned += ch;
    }
  }

  if (!cleaned) {
    return {
      value: "",
      rawValue: rawValue,
      valid: false,
      error: "Barcode is empty after removing suffix characters",
    };
  }

  if (URL_PATTERN.test(cleaned)) {
    return {
      value: "",
      rawValue: rawValue,
      valid: false,
      error: "URL QR codes are not valid inventory barcodes",
    };
  }

  if (cleaned.includes("/") || cleaned === "." || cleaned === "..") {
    return {
      value: "",
      rawValue: rawValue,
      valid: false,
      error: "Barcode contains unsafe path characters",
    };
  }

  if (cleaned.length > maxLength) {
    return {
      value: "",
      rawValue: rawValue,
      valid: false,
      error: `Barcode exceeds maximum length of ${maxLength}`,
    };
  }

  return {
    value: cleaned,
    rawValue: rawValue,
    valid: true,
  };
}

/**
 * Barcode symbology types.
 */
export type BarcodeType =
  | "UPC_A"
  | "UPC_E"
  | "EAN_8"
  | "EAN_13"
  | "GTIN"
  | "CODE_128"
  | "CODE_39"
  | "QR"
  | "UNKNOWN";

/**
 * Typed barcode record for inventory items.
 */
export interface BarcodeRecord {
  value: string;
  normalizedValue: string;
  type: BarcodeType;
  isPrimary: boolean;
}

/**
 * Attempt to detect barcode type from its length and pattern.
 * This is a best-effort heuristic — scanners report the actual type.
 */
export function detectBarcodeType(value: string): BarcodeType {
  const len = value.length;
  const allDigits = /^\d+$/.test(value);

  if (!allDigits) {
    // Contains letters — could be Code 39, Code 128, or QR
    if (len <= 64) return "CODE_128";
    return "QR";
  }

  // All digits — U.P.C./EAN/GTIN family
  if (len === 8) return "EAN_8";
  if (len === 12) return "UPC_A";
  if (len === 13) return "EAN_13";
  if (len === 14) return "GTIN";
  if (len === 6) return "UPC_E";

  return "UNKNOWN";
}

/**
 * Check if a barcode string is all digits and could be a numeric identifier.
 * Used to ensure we never numeric-parse barcodes.
 */
export function isNumericBarcode(value: string): boolean {
  return /^\d+$/.test(value);
}
